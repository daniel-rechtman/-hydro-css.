{
  "name": "phoneconfig",
  "type": "object",
  "title": "Phone Configuration",
  "description": "Stores the user's phone number and dialer preferences",
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "User's phone number in E.164 format (e.g. +972501234567)",
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "minLength": 8,
      "maxLength": 16
    },
    "display_name": {
      "type": "string",
      "description": "Friendly name for this phone configuration",
      "maxLength": 100,
      "default": "הטלפון שלי"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether this phone configuration is currently active",
      "default": true
    },
    "twilio_enabled": {
      "type": "boolean",
      "description": "Whether Twilio bridging is enabled for actual call initiation",
      "default": false
    }
  },
  "required": ["phone_number"],
  "rls": {
    "create": true,
    "read": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" }
  }
}
